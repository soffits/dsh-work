{
  "name": "@soffits/dsh-work",
  "version": "0.1.8",
  "description": "A work page for DeepSeek Harness: the issues of a work board as columns, and each issue as a group chat of its comments and the DSH sessions working on it, where people and agents talk and @mention each other.",
  "type": "module",
  "license": "MIT",
  "author": "Sakina",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soffits/dsh-work.git"
  },
  "homepage": "https://github.com/soffits/dsh-work#readme",
  "bugs": {
    "url": "https://github.com/soffits/dsh-work/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "kanban",
    "chat",
    "agents",
    "work-board"
  ],
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "client.js",
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "docs/*.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@soffits/dsh-ui-kit",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "check": "for f in index.js client.js src/*.js test/*.js; do node --check \"$f\" || exit 1; done",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "devDependencies": {
    "yaml": "^2.9.1"
  }
}
